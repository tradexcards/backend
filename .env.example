# TradeX Backend Environment Variables
# Copy this to .env and fill in your values

# ── Network ──────────────────────────────────────────────────────────────────
# Set to "true" for mainnet, "false" for devnet
MAINNET=false

# ── Program ──────────────────────────────────────────────────────────────────
# Required for both mainnet and devnet
# Mainnet: TRDXCHHWWZdQXxkGFJxek1KU2hn19687xztNBy99Ca1
PROGRAM_ID=
# USDC_MINT= (defaults: mainnet=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v, devnet=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
DEBUG=false

# ── Solana ───────────────────────────────────────────────────────────────────
# Required for mainnet, optional for devnet (uses public endpoint)
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=

# ── Oracle/Keeper ────────────────────────────────────────────────────────────
# Path to Solana keypair for signing oracle updates
ORACLE_KEYPAIR_PATH=./keypair.json
KEEPER_KEYPAIR_PATH=./keypair.json
KEEPER_ENABLED=true
KEEPER_UPDATE_INTERVAL=300

# ── Admin ────────────────────────────────────────────────────────────────────
# Required for mainnet (16+ chars), optional for devnet
ADMIN_PASSWORD=

# ── Proxy (Bright Data) ──────────────────────────────────────────────────────
# Optional: Enable proxy for TCGPlayer requests
PROXY_ENABLED=false
PROXY_HOST=brd.superproxy.io
PROXY_PORT=33335
PROXY_USER=
PROXY_PASS=
PROXY_COUNTRY=de

# ── Cache TTLs (seconds) ─────────────────────────────────────────────────────
# CACHE_TTL_PRICING=300
# CACHE_TTL_LISTINGS=21600
# CACHE_TTL_SALES=21600
# CACHE_TTL_HISTORY=21600

# ── Rate Limiting ────────────────────────────────────────────────────────────
# RATE_DELAY=2
# RATE_MAX_CONCURRENT=3
# RATE_TIMEOUT=30

# ── Scheduler ────────────────────────────────────────────────────────────────
# CRON_HOUR=6
# CRON_MINUTE=0

# ── Security ─────────────────────────────────────────────────────────────────
# Enable if behind a reverse proxy (nginx, cloudflare, etc)
TRUST_PROXY=false
